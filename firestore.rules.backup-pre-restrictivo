rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read; 
      allow write;
    }
    match /langgraph_checkpoints/{document=**} {
      allow read, write: if false; // Solo accesible por el Admin SDK
    }
    match /counters/{document=**} {
      allow read, write: if false; // Solo accesible por el Admin SDK
    }
  }
}
